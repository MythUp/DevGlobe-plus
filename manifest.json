{
  "manifest_version": 3,
  "name": "DevGlobe+",
  "version": "3.0.0",
  "description": "Adds custom country and language tooltips, blocks unavailable repository links on DevGlobe, makes statistics sortable, and provides a lot of Quality of Life features.",
  "author": "MythUp",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://devglobe.app/*",
    "https://devglobe.xyz/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DevGlobe+"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://devglobe.app/space*",
        "https://devglobe.xyz/space*",
        "https://devglobe.app/stats*",
        "https://devglobe.xyz/stats*",
        "https://devglobe.app/developers/*",
        "https://devglobe.xyz/developers/*",
        "https://devglobe.app/plugins*",
        "https://devglobe.xyz/plugins*",
        "https://devglobe.app/projects*",
        "https://devglobe.xyz/projects*"
      ],
      "js": ["space-content.js"],
      "run_at": "document_idle"
    }
  ]
}